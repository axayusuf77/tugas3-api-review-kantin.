  "definitions": {
    "UserInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Bagas Pratama"
        },
        "email": {
          "type": "string",
          "example": "bagas2@student.test"
        },
        "passwordHash": {
          "type": "string",
          "example": "hash_contoh"
        },
        "role": {
          "type": "string",
          "example": "customer"
        }
      },
      "required": [
        "name",
        "email",
        "passwordHash",
        "role"
      ]
    },
    "StallInput": {
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "number",
          "example": 2
        },
        "name": {
          "type": "string",
          "example": "Warung Baru"
        },
        "category": {
          "type": "string",
          "example": "Nasi"
        },
        "location": {
          "type": "string",
          "example": "Kantin FK"
        },
        "description": {
          "type": "string",
          "example": ""
        }
      },
      "required": [
        "ownerId",
        "name"
      ]
    },
    "MenuItemInput": {
      "type": "object",
      "properties": {
        "stallId": {
          "type": "number",
          "example": 1
        },
        "name": {
          "type": "string",
          "example": "Menu Baru"
        },
        "price": {
          "type": "number",
          "example": 15000
        },
        "isAvailable": {
          "type": "boolean",
          "example": true
        }
      },
      "required": [
        "stallId",
        "name",
        "price"
      ]
    },
    "ReviewInput": {
      "type": "object",
      "properties": {
        "stallId": {
          "type": "number",
          "example": 1
        },
        "userId": {
          "type": "number",
          "example": 12
        },
        "rating": {
          "type": "number",
          "example": 5
        },
        "comment": {
          "type": "string",
          "example": "Enak banget"
        }
      },
      "required": [
        "stallId",
        "userId",
        "rating"
      ]
    },
    "LikeInput": {
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "number",
          "example": 1
        },
        "userId": {
          "type": "number",
          "example": 13
        }
      },
      "required": [
        "reviewId",
        "userId"
      ]
    },
    "FlagStatusInput": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "resolved"
        }
      },
      "required": [
        "status"
      ]
    },
    "AuditLogInput": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "number",
          "example": 1
        },
        "action": {
          "type": "string",
          "example": "CREATE"
        },
        "targetTable": {
          "type": "string",
          "example": "STALLS"
        },
        "targetId": {
          "type": "number",
          "example": 1
        },
        "metadata": {
          "type": "string",
          "example": "{}"
        }
      },
      "required": [
        "userId",
        "action",
        "targetTable",
        "targetId"
      ]
    }
  }
